###
# @name createdBook
POST {{baseUrl}}/api/books
Authorization: Bearer {{loginAdmin.response.body.result.token}}
Content-Type: application/json

{
  "title": "PostgreSQL Internals",
  "author": "Egor Rogov",
  "year": 2023,
  "genre": "Databases",
  "totalCopies": 2
}

###
GET {{baseUrl}}/api/books/{{createdBook.response.body.result.id}}
Authorization: Bearer {{loginAdmin.response.body.result.token}}

###
PUT {{baseUrl}}/api/books/{{createdBook.response.body.result.id}}
Authorization: Bearer {{loginAdmin.response.body.result.token}}
Content-Type: application/json

{
  "title": "PostgreSQL 14 Internals",
  "author": "Egor Rogov",
  "year": 2023,
  "genre": "Databases",
  "totalCopies": 3
}

